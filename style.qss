/* Chatbook — modern light theme with indigo accents */

* {
    font-family: "Segoe UI", "Ubuntu", "Cantarell", "Noto Sans", "Helvetica Neue", sans-serif;
}

QDialog, QWidget {
    background-color: #f4f1ff;
    color: #1c1c28;
}

QLabel {
    color: #1c1c28;
    background: transparent;
}

QLabel#label {
    background-color: #5b5ce2;
    color: #ffffff;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 8px;
    border: none;
}

QLabel#label_Nickname {
    color: #3b3c98;
    font-size: 14px;
    font-weight: 600;
}

QLabel#label_2 {
    color: #4b4b63;
}

QLineEdit, QTextEdit, QTextBrowser {
    background-color: #ffffff;
    color: #1c1c28;
    border: 1px solid #b7b3e8;
    border-radius: 10px;
    padding: 8px 12px;
    selection-background-color: #5b5ce2;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #5b5ce2;
}

QPushButton {
    background-color: #ecebff;
    color: #3b3c98;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 600;
    min-height: 32px;
}

QPushButton:hover {
    background-color: #dcd9ff;
}

QPushButton:pressed {
    background-color: #5b5ce2;
    color: #ffffff;
}

QPushButton#pushButton,
QPushButton#pushButton_3,
QPushButton#button_send,
QPushButton#button_createButton,
QPushButton#button_createChatRoom {
    background-color: #5b5ce2;
    color: #ffffff;
}

QPushButton#pushButton:hover,
QPushButton#pushButton_3:hover,
QPushButton#button_send:hover,
QPushButton#button_createButton:hover,
QPushButton#button_createChatRoom:hover {
    background-color: #4a4bd0;
}

QPushButton#pushButton_2,
QPushButton#button_logOut,
QPushButton#button_returnButton {
    background-color: #ffffff;
    color: #5b5ce2;
    border: 1px solid #d9d6fe;
}

QPushButton#button_Admin {
    background-color: #3b3c98;
    color: #ffffff;
}

QPushButton#button_Admin:hover {
    background-color: #2f3080;
}

QScrollBar:vertical {
    background: #f4f1ff;
    width: 10px;
    margin: 2px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #c7c4ef;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e6e3f7;
    border-radius: 14px;
    margin-top: 18px;
    padding: 10px 6px 6px 6px;
    font-weight: 600;
    color: #3b3c98;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #5b5ce2;
    background-color: #f4f1ff;
}

QScrollArea {
    background-color: #ffffff;
    border: none;
    border-radius: 10px;
}

QScrollArea > QWidget > QWidget {
    background-color: #ffffff;
}

QTabWidget::pane {
    border: 1px solid #e6e3f7;
    border-radius: 12px;
    background: #ffffff;
    top: -1px;
}

QTabBar::tab {
    background: #ecebff;
    color: #3b3c98;
    padding: 8px 14px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #5b5ce2;
    color: #ffffff;
}

QTextBrowser {
    background-color: #faf9ff;
    border: 1px solid #e6e3f7;
    border-radius: 12px;
    padding: 10px;
}

QLabel#creationMessage {
    color: #30a46c;
    font-weight: 600;
}

QLabel#creationMessage_2,
QLabel#label_5 {
    color: #e5484d;
    font-weight: 600;
}
